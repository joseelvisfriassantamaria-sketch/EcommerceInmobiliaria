@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión · TrámiteRD</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tramiterd.css" asp-append-version="true" />
</head>
<body>
    <div class="trd-shell">
        <div class="trd-card">
            <div class="trd-statusbar">
                <span>9:41</span>
                <span class="trd-statusbar__dots"><i></i><i></i><i></i></span>
            </div>

            <div class="trd-logo" style="margin-bottom:22px">
                <span class="trd-logo__badge">T</span>
                <span class="trd-logo__text"><b>Trámite</b><span>RD</span></span>
            </div>

            <h1 class="trd-title">Bienvenido a TrámiteRD</h1>
            <p class="trd-subtitle" style="margin-bottom:22px">Inicia sesión para continuar con tus trámites.</p>

            @if (TempData["Ok"] is string ok)
            {
                <div class="trd-alert trd-alert--ok">@ok</div>
            }

            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="trd-alert trd-alert--err"></div>

                <div class="trd-field">
                    <label asp-for="Email" class="trd-label">Correo electrónico</label>
                    <input asp-for="Email" class="trd-input" placeholder="tucorreo@correo.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="trd-error"></span>
                </div>

                <div class="trd-field">
                    <label asp-for="Password" class="trd-label">Contraseña</label>
                    <div class="trd-input-wrap">
                        <input asp-for="Password" class="trd-input" type="password" autocomplete="current-password" data-trd-password />
                        <button type="button" class="trd-input-action" data-trd-toggle>Mostrar</button>
                    </div>
                    <span asp-validation-for="Password" class="trd-error"></span>
                </div>

                <button class="btn-trd btn-trd--primary" type="submit" style="margin-top:6px">Iniciar sesión</button>
            </form>

            <p class="trd-foot">¿No tienes cuenta? <a asp-action="Registro">Crear cuenta con mi cédula</a></p>
        </div>
    </div>

    <script src="~/js/tramiterd.js" asp-append-version="true"></script>
</body>
</html>
