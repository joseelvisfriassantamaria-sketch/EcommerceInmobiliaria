@inject AutorizacionService Auth
@{
    ViewData["Title"] = "Inicio";
    var ctx = await Auth.ObtenerContextoAsync(User);
    var primerNombre = (User.Identity!.Name ?? "").Split(' ').FirstOrDefault();
    var modulos = new[]
    {
        (Permiso: "USUARIOS_VER",    Icono: "👤", Titulo: "Usuarios",         Desc: "Consulta y administración de usuarios.",      Ctrl: "Usuarios"),
        (Permiso: "ROLES_GESTIONAR", Icono: "🛡️", Titulo: "Roles y permisos", Desc: "Define qué puede hacer cada perfil.",           Ctrl: "Roles"),
        (Permiso: "BITACORA_VER",    Icono: "📜", Titulo: "Bitácora",         Desc: "Trazabilidad de accesos y operaciones.",      Ctrl: "Bitacora"),
        (Permiso: "PROPIEDADES_VER", Icono: "🗂️", Titulo: "Trámites",         Desc: "Catálogo de trámites disponibles.",           Ctrl: "Propiedades"),
        (Permiso: "DISENOS_VER",     Icono: "📝", Titulo: "Solicitudes",      Desc: "Solicitudes y documentos en proceso.",        Ctrl: "Disenos")
    };
    var visibles = modulos.Where(m => ctx.Permisos.Contains(m.Permiso)).ToList();
}

<div class="trd-page-head">
    <h1>Hola, @primerNombre 👋</h1>
    <p class="trd-muted" style="margin:0">
        Tu perfil: <span class="trd-badge">@(string.IsNullOrEmpty(ctx.Rol) ? "sin rol activo" : ctx.Rol)</span>
    </p>
</div>

@if (visibles.Count == 0)
{
    <div class="trd-alert trd-alert--warn">Tu perfil no tiene módulos habilitados. Contacta al administrador.</div>
}
else
{
    <p class="trd-muted" style="margin:0 0 14px">¿Qué necesitas hacer?</p>
    <div class="trd-grid">
        @foreach (var m in visibles)
        {
            <a class="trd-modcard" asp-controller="@m.Ctrl" asp-action="Index">
                <span class="trd-modcard__icon">@m.Icono</span>
                <h2 class="trd-modcard__title">@m.Titulo</h2>
                <p class="trd-modcard__desc">@m.Desc</p>
            </a>
        }
    </div>
}
