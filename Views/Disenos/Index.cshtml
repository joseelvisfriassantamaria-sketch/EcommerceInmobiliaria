@inject AutorizacionService Auth
@{
    ViewData["Title"] = "Solicitudes";
    var ctx = await Auth.ObtenerContextoAsync(User);
    var muestra = new[]
    {
        (Nombre: "Solicitud de cita · Pasaporte", Estado: "En proceso"),
        (Nombre: "Acta de nacimiento",            Estado: "Aprobado"),
        (Nombre: "Renovación de cédula",          Estado: "Borrador")
    };
}

<div class="trd-row-between trd-page-head">
    <div>
        <h1>Solicitudes</h1>
        <p class="trd-muted" style="margin:0">Solicitudes y documentos en proceso.</p>
    </div>
    @if (ctx.Permisos.Contains("DISENOS_GESTIONAR"))
    {
        <a class="btn-trd btn-trd--primary btn-trd--sm" asp-action="Nuevo">+ Nueva solicitud</a>
    }
</div>

<div class="trd-grid">
    @foreach (var d in muestra)
    {
        <div class="trd-modcard" style="cursor:default">
            <span class="trd-badge trd-badge--gray" style="margin-bottom:10px">@d.Estado</span>
            <h2 class="trd-modcard__title">@d.Nombre</h2>
        </div>
    }
</div>
<p class="trd-muted trd-small" style="margin-top:14px">Módulo de ejemplo para demostrar las restricciones por perfil (se completa en épicas posteriores).</p>
