@inject AutorizacionService Auth
@{
    var ctx = User.Identity?.IsAuthenticated == true ? await Auth.ObtenerContextoAsync(User) : null;
    Func<string, bool> puede = c => ctx != null && ctx.Permisos.Contains(c);
    var ctrl = ViewContext.RouteData.Values["controller"] as string ?? "";
    Func<string, string> act = c => string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
    var nombre = User.Identity?.Name ?? "";
    var iniciales = string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Inicio") · TrámiteRD</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tramiterd.css" asp-append-version="true" />
</head>
<body>
    <header class="trd-topbar">
        <a class="trd-logo trd-logo--sm" asp-controller="Home" asp-action="Index" style="text-decoration:none">
            <span class="trd-logo__badge">T</span>
            <span class="trd-logo__text"><b>Trámite</b><span>RD</span></span>
        </a>
        @if (ctx != null)
        {
            <div class="trd-topbar__user">
                <span class="trd-avatar">@iniciales</span>
                <span>
                    <span class="trd-topbar__name">@nombre</span><br />
                    <span class="trd-badge">@(string.IsNullOrEmpty(ctx.Rol) ? "Sin rol" : ctx.Rol)</span>
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn-trd btn-trd--outline btn-trd--sm">Salir</button>
                </form>
            </div>
        }
    </header>

    @if (ctx != null)
    {
        <nav class="trd-nav">
            <div class="trd-nav__inner">
                <a class="@act("Home")" asp-controller="Home" asp-action="Index">Inicio</a>
                @if (puede("USUARIOS_VER"))
                {
                    <a class="@act("Usuarios")" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                }
                @if (puede("ROLES_GESTIONAR"))
                {
                    <a class="@act("Roles")" asp-controller="Roles" asp-action="Index">Roles y permisos</a>
                }
                @if (puede("BITACORA_VER"))
                {
                    <a class="@act("Bitacora")" asp-controller="Bitacora" asp-action="Index">Bitácora</a>
                }
            </div>
        </nav>
    }

    <main class="trd-container">
        @if (TempData["Ok"] is string ok)
        {
            <div class="trd-alert trd-alert--ok">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="trd-alert trd-alert--err">@err</div>
        }
        @RenderBody()
    </main>

    <script src="~/js/tramiterd.js" asp-append-version="true"></script>
</body>
</html>
