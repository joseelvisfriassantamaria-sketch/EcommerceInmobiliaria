@model List<Rol>
@{ ViewData["Title"] = "Roles y permisos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Roles y permisos</h1>
    <a class="btn btn-dark" asp-action="Crear">Nuevo rol</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Rol</th><th>Descripción</th><th class="text-center">Usuarios</th><th class="text-center">Permisos</th><th>Estado</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td class="fw-semibold">@r.Nombre</td>
                    <td class="text-muted">@r.Descripcion</td>
                    <td class="text-center">@r.TotalUsuarios</td>
                    <td class="text-center">@r.TotalPermisos</td>
                    <td>@if (r.Activo) { <span class="badge text-bg-success">Activo</span> } else { <span class="badge text-bg-secondary">Inactivo</span> }</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-dark" asp-action="Permisos" asp-route-id="@r.RolId">Permisos</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@r.RolId">Editar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
