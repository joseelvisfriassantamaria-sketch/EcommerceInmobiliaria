@model PermisosRolViewModel
@{
    ViewData["Title"] = "Permisos del rol";
    var esAdmin = Model.Rol.Nombre == "Administrador";
}

<div class="trd-page-head">
    <h1>Permisos · @Model.Rol.Nombre</h1>
    <p class="trd-muted" style="margin:0">Marca lo que este perfil puede hacer. Los cambios se aplican de inmediato a todos sus usuarios.</p>
</div>

@if (esAdmin)
{
    <div class="trd-alert trd-alert--warn">El rol Administrador siempre conserva todos los permisos y no se puede modificar.</div>
}

<form asp-action="Permisos" method="post">
    <input type="hidden" name="rolId" value="@Model.Rol.RolId" />
    <div class="trd-grid">
        @foreach (var grupo in Model.Permisos.GroupBy(p => p.Modulo))
        {
            <div class="trd-panel trd-permgroup">
                <h3>@grupo.Key</h3>
                @foreach (var p in grupo)
                {
                    <label class="trd-check" for="p@(p.PermisoId)">
                        <input type="checkbox" name="permisoIds" value="@p.PermisoId"
                               id="p@(p.PermisoId)" checked="@Model.Asignados.Contains(p.PermisoId)" disabled="@esAdmin" />
                        <span class="trd-check__txt"><b>@p.Descripcion</b><small>@p.Codigo</small></span>
                    </label>
                }
            </div>
        }
    </div>
    <div class="trd-actions" style="margin-top:18px">
        @if (!esAdmin) { <button class="btn-trd btn-trd--primary btn-trd--sm" type="submit">Guardar permisos</button> }
        <a class="btn-trd btn-trd--outline btn-trd--sm" asp-action="Index">Volver</a>
    </div>
</form>
