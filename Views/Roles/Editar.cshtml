@model RolFormViewModel
@{ ViewData["Title"] = "Editar rol"; }

<div class="trd-page-head"><h1>Editar rol</h1></div>

<div class="trd-panel" style="max-width:520px">
    <form asp-action="Editar" method="post" novalidate>
        <input type="hidden" asp-for="RolId" />
        <div asp-validation-summary="ModelOnly" class="trd-alert trd-alert--err"></div>
        <div class="trd-field">
            <label asp-for="Nombre" class="trd-label">Nombre</label>
            <input asp-for="Nombre" class="trd-input" />
            <span asp-validation-for="Nombre" class="trd-error"></span>
        </div>
        <div class="trd-field">
            <label asp-for="Descripcion" class="trd-label">Descripción</label>
            <input asp-for="Descripcion" class="trd-input" />
            <span asp-validation-for="Descripcion" class="trd-error"></span>
        </div>
        <div class="trd-check" style="border:none;padding:4px 0 18px">
            <input asp-for="Activo" />
            <span class="trd-check__txt"><b>Rol activo</b><small>Un rol inactivo no concede acceso a sus usuarios.</small></span>
        </div>
        <div class="trd-actions">
            <button class="btn-trd btn-trd--primary btn-trd--sm" type="submit">Guardar</button>
            <a class="btn-trd btn-trd--outline btn-trd--sm" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
