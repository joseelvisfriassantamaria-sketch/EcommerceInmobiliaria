@model EditarUsuarioViewModel
@{ ViewData["Title"] = "Asignar rol"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Asignar rol</h1>
                <p class="text-muted">@Model.Usuario.NombreCompleto · @Model.Usuario.Email</p>
                <form asp-action="Editar" method="post">
                    <input type="hidden" name="id" value="@Model.Usuario.UsuarioId" />
                    <div class="mb-3">
                        <label class="form-label" for="rolId">Rol</label>
                        <select class="form-select" id="rolId" name="rolId">
                            @foreach (var r in Model.Roles)
                            {
                                <option value="@r.RolId" selected="@(r.RolId == Model.Usuario.RolId)">@r.Nombre @(r.Activo ? "" : "(inactivo)")</option>
                            }
                        </select>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="activo" name="activo" value="true" checked="@Model.Usuario.Activo" />
                        <input type="hidden" name="activo" value="false" />
                        <label class="form-check-label" for="activo">Cuenta activa</label>
                    </div>
                    <button class="btn btn-dark" type="submit">Guardar</button>
                    <a class="btn btn-link" asp-action="Index">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
