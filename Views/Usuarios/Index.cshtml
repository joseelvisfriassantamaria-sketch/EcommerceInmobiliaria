@model List<Usuario>
@inject AutorizacionService Auth
@{
    ViewData["Title"] = "Usuarios";
    var ctx = await Auth.ObtenerContextoAsync(User);
    var puedeGestionar = ctx.Permisos.Contains("USUARIOS_GESTIONAR");
}

<div class="trd-page-head">
    <h1>Usuarios</h1>
    <p class="trd-muted" style="margin:0">Consulta y administración de las cuentas del sistema.</p>
</div>

<div class="trd-tablewrap">
    <table class="trd-table">
        <thead>
            <tr>
                <th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Registro (UTC)</th>
                @if (puedeGestionar) { <th></th> }
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td style="font-weight:600">@u.NombreCompleto</td>
                <td>@u.Email</td>
                <td><span class="trd-badge">@u.RolNombre</span></td>
                <td>
                    @if (!u.Activo) { <span class="trd-badge trd-badge--gray">Inactivo</span> }
                    else if (u.BloqueadoHasta.HasValue && u.BloqueadoHasta.Value > DateTime.UtcNow) { <span class="trd-badge trd-badge--amber">Bloqueado</span> }
                    else { <span class="trd-badge trd-badge--green">Activo</span> }
                </td>
                <td class="trd-muted">@u.FechaRegistro.ToString("yyyy-MM-dd HH:mm")</td>
                @if (puedeGestionar)
                {
                    <td class="num"><a class="btn-trd btn-trd--outline btn-trd--sm" asp-action="Editar" asp-route-id="@u.UsuarioId">Asignar rol</a></td>
                }
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="trd-muted" style="text-align:center;padding:30px">Sin usuarios.</td></tr> }
        </tbody>
    </table>
</div>
