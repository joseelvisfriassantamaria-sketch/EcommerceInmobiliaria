@inject AutorizacionService Auth
@{
    ViewData["Title"] = "Trámites";
    var ctx = await Auth.ObtenerContextoAsync(User);
    var muestra = new[]
    {
        (Nombre: "Pasaporte por primera vez",      Inst: "DGP",     Tiempo: "5–10 días"),
        (Nombre: "Renovación de licencia",         Inst: "INTRANT", Tiempo: "1–3 días"),
        (Nombre: "Certificado de no antecedentes", Inst: "PGR",     Tiempo: "En línea")
    };
}

<div class="trd-row-between trd-page-head">
    <div>
        <h1>Trámites</h1>
        <p class="trd-muted" style="margin:0">Catálogo de trámites disponibles.</p>
    </div>
    @if (ctx.Permisos.Contains("PROPIEDADES_GESTIONAR"))
    {
        <a class="btn-trd btn-trd--primary btn-trd--sm" asp-action="Publicar">+ Publicar trámite</a>
    }
</div>

<div class="trd-grid">
    @foreach (var p in muestra)
    {
        <div class="trd-modcard" style="cursor:default">
            <span class="trd-badge" style="margin-bottom:10px">@p.Inst</span>
            <h2 class="trd-modcard__title">@p.Nombre</h2>
            <p class="trd-modcard__desc">Tiempo estimado: @p.Tiempo</p>
        </div>
    }
</div>
<p class="trd-muted trd-small" style="margin-top:14px">Módulo de ejemplo para demostrar las restricciones por perfil (se completa en épicas posteriores).</p>
